# ============================================
# TorStream - Environment Configuration
# ============================================

# REQUIRED: Change these to secure random keys (min 32 characters)
SECRET_KEY=mycatfluffy_466_ilovepizza_abcdefghijk_32chars
ADMIN_SECRET_KEY=myothercatwhiskers_466_ihatemondays_32chars

# Application
DEBUG=false
APP_NAME=TorStream

# Database
POSTGRES_USER=torstream
POSTGRES_PASSWORD=change-this-secure-password
POSTGRES_DB=torstream
DATABASE_URL=postgresql+asyncpg://torstream:change-this-secure-password@postgres:5432/torstream

# Redis
REDIS_URL=redis://:change-this-redis-password@redis:6379/0
REDIS_PASSWORD=change-this-redis-password

# BTCPay Server (optional - leave empty if not using payments)
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=

# Pricing (in USD)
PREMIUM_MONTHLY_PRICE=9.99
PREMIUM_YEARLY_PRICE=99.99

# File Storage
VIDEO_STORAGE_PATH=/app/static/uploads
PREVIEW_STORAGE_PATH=/app/static/previews
MAX_UPLOAD_SIZE=5368709120

# Security
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW=900

# Tor
TOR_HOSTNAME=

# Feature Flags
REGISTRATION_ENABLED=true
UPLOADS_ENABLED=true
